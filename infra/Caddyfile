{
	admin off
	auto_https off
	persist_config off
}

http://:8080 {
	root * /usr/share/caddy
	encode zstd gzip
	log {
		output stdout
		format json
	}
	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
		Cache-Control no-store
	}

	handle /healthz {
		@ready file /index.html
		respond @ready "ok" 200
		respond "unavailable" 503
	}

	@private path /.env* /.git* /node_modules* /src/* /data/* /scripts/* /package*.json /Dockerfile /Caddyfile
	handle @private {
		respond "Not found" 404
	}
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	@static path /release.json /knight.svg /favicon.ico
	handle @static {
		file_server
	}
	handle {
		try_files {path} /index.html
		file_server
	}
	handle_errors {
		header Cache-Control no-store
		respond "Request failed" {err.status_code}
	}
}
